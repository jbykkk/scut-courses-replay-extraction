{
  "manifest_version": 3,
  "name": "SCUT 课堂助手",
  "version": "0.14.0",
  "minimum_chrome_version": "116",
  "description": "本地课堂字幕、重要事项提醒、回放转写与课程笔记，优先适配 Edge。",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen",
    "alarms",
    "webRequest",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://video.jw.scut.edu.cn/*",
    "https://video-jw-443.webvpn.scut.edu.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://video.jw.scut.edu.cn/*",
        "https://video-jw-443.webvpn.scut.edu.cn/*"
      ],
      "js": [
        "site-entry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://video.jw.scut.edu.cn/livingroom*",
        "https://video-jw-443.webvpn.scut.edu.cn/livingroom*"
      ],
      "js": [
        "session-view.js",
        "replay-seek.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "local-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "study-popup.html",
    "default_icon": {
      "16": "icons/assistant-16.png",
      "32": "icons/assistant-32.png",
      "48": "icons/assistant-48.png",
      "128": "icons/assistant-128.png"
    }
  },
  "icons": {
    "16": "icons/assistant-16.png",
    "32": "icons/assistant-32.png",
    "48": "icons/assistant-48.png",
    "128": "icons/assistant-128.png"
  }
}
